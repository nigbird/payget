generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  name                 String?
  email                String?                @unique
  password             String?
  role                 UserRole               @default(MERCHANT)
  customRoleId         String?
  customRole           Role?                  @relation(fields: [customRoleId], references: [id])
  merchantId           String?
  merchant             Merchant?              @relation(fields: [merchantId], references: [id])
  isHeadOffice         Boolean                @default(false)
  district             String?
  branch               String?
  status               UserStatus             @default(ACTIVE)
  firstLogin           Boolean                @default(true)
  sessionVersion       Int                    @default(1)
  failedLoginAttempts  Int                    @default(0)
  lockoutUntil         DateTime?
  passwordResetToken   String?                @unique
  passwordResetExpires DateTime?
  auditLogs            AuditLog[]
  createdRoles         Role[]                 @relation("RoleCreator")
  createdMerchants     Merchant[]             @relation("MerchantCreator")
  limitsSetMerchants   Merchant[]             @relation("MerchantLimitsSetter")
  approvedMerchants    Merchant[]             @relation("MerchantApprover")
  refreshTokens        RefreshToken[]
  activeSessions       ActiveSession[]
  madeCashbackRequests CashbackRequest[]      @relation("CashbackRequestMaker")
  checkedCashbackRequests CashbackRequest[]   @relation("CashbackRequestChecker")
  madeSubsidiaryAccountRequests SubsidiaryAccountRequest[] @relation("SubsidiaryAccountRequestMaker")
  checkedSubsidiaryAccountRequests SubsidiaryAccountRequest[] @relation("SubsidiaryAccountRequestChecker")
  submittedPaymentEligibilityImports PaymentEligibilityImport[] @relation("PaymentEligibilitySubmitter")
  reviewedPaymentEligibilityImports PaymentEligibilityImport[] @relation("PaymentEligibilityReviewer")
  madePaymentReconciliationRequests PaymentReconciliationRequest[] @relation("PaymentReconciliationRequestMaker")
  checkedPaymentReconciliationRequests PaymentReconciliationRequest[] @relation("PaymentReconciliationRequestChecker")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model RefreshToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId    String?
  session      ActiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  familyId     String   // groups rotated tokens; revoke whole family on reuse
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  replacedById String?  @unique
  replacedBy   RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("RefreshTokenReplacement")

  userAgent    String?
  ipAddress    String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([sessionId])
}

model ActiveSession {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime       @default(now())
  revokedAt      DateTime?
  userAgent      String?
  ipAddress      String?
  refreshTokens  RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt, expiresAt])
}

enum UserRole {
  ADMIN
  MAKER
  CHECKER
  HEAD_OFFICE
  MERCHANT
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdBy   String?
  creator     User?            @relation("RoleCreator", fields: [createdBy], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  category    String           // e.g., "DASHBOARD", "MERCHANT", "USER_ROLE", "TRANSACTION"
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g., "ROLE_CREATE", "MERCHANT_APPROVE"
  entityType  String   // e.g., "ROLE", "MERCHANT", "USER"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model Merchant {
  id                  String           @id
  name                String
  email               String           @unique
  password            String?
  logoUrl             String?
  jweSecret           String
  accountNumber       String
  dailyLimit          Float            @default(0)
  transactionLimit    Float            @default(0)
  dailyCountLimit     Float            @default(0)
  status              MerchantStatus   @default(PENDING)
  rejectionReason     String?
  businessDescription String?
  websiteUrl          String?
  callbackUrl         String?
  contactName         String
  contactUsername     String
  branchName          String
  district            String
  category            String
  businessType        String
  riskFactors         String[]
  createdBy           String?
  creator             User?            @relation("MerchantCreator", fields: [createdBy], references: [id])
  limitsSetBy         String?
  limitsSetter        User?            @relation("MerchantLimitsSetter", fields: [limitsSetBy], references: [id])
  approvedBy          String?
  approver            User?            @relation("MerchantApprover", fields: [approvedBy], references: [id])
  createdAt           DateTime         @default(now())
  passwordResetToken  String?          @unique
  passwordResetExpires DateTime?
  updateComments      Json?            // Field-level comments for corrections
  updateTokens        MerchantUpdateToken[]
  documents           MerchantDocument[]
  transactions        Transaction[]
  teamMembers         MerchantTeamMember[]
  users               User[]
  nonces              RequestNonce[]
  qrEnabled           Boolean          @default(false)
  qrLogoUrl           String?
  qrCodes             MerchantQrCode[]
  cashbackConfig      MerchantCashbackConfig?
  cashbackTransactions CashbackTransaction[]
  cashbackEligibleCustomers CashbackEligibleCustomer[]
  subsidiaryAccountRequests SubsidiaryAccountRequest[]
  paymentEligibilityImports PaymentEligibilityImport[]
  paymentEligibleCustomers PaymentEligibleCustomer[]
  itemCategories      MerchantItemCategory[]
  items               MerchantItem[]
}

enum CashbackMode {
  ALL_CUSTOMERS
  CATEGORY_ELIGIBLE
}

enum CashbackProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum CashbackRequestType {
  REFERENCE_UPDATE
  RETRY
  /// Operator has an FT from an internal bank receipt proving the cashback
  /// transfer landed. Settles the cashback to COMPLETED without a provider call.
  MANUAL_SETTLE
}

enum CashbackRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

model CashbackRequest {
  id                   String                 @id @default(cuid())
  type                 CashbackRequestType
  cashbackTransactionId String
  cashbackTransaction  CashbackTransaction    @relation(fields: [cashbackTransactionId], references: [id], onDelete: Cascade)
  oldTransactionReference String?
  newTransactionReference String?
  /// FT from the bank receipt, supplied by the maker for MANUAL_SETTLE requests.
  ftNumber             String?
  reason               String
  comments             String?
  status               CashbackRequestStatus  @default(PENDING)
  makerId              String
  maker                User                   @relation("CashbackRequestMaker", fields: [makerId], references: [id])
  checkerId            String?
  checker              User?                  @relation("CashbackRequestChecker", fields: [checkerId], references: [id])
  checkedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([cashbackTransactionId])
  @@index([status])
  @@index([createdAt])
}

enum SubsidiaryAccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubsidiaryAccountRequest {
  id                     String                         @id @default(cuid())
  merchantId             String
  merchant               Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requestedAccountNumber String
  previousAccountNumber  String?
  reason                 String
  comments               String?
  status                 SubsidiaryAccountRequestStatus @default(PENDING)
  makerId                String
  maker                  User                           @relation("SubsidiaryAccountRequestMaker", fields: [makerId], references: [id])
  checkerId              String?
  checker                User?                          @relation("SubsidiaryAccountRequestChecker", fields: [checkerId], references: [id])
  checkedAt              DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([merchantId])
  @@index([status])
}

enum PaymentEligibilityRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PaymentEligibilityRequestType {
  IMPORT
  REMOVAL
}

model PaymentEligibilityImport {
  id          String                           @id @default(cuid())
  merchantId  String
  merchant    Merchant                         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type        PaymentEligibilityRequestType    @default(IMPORT)
  fileName    String?
  totalRows   Int
  status      PaymentEligibilityRequestStatus  @default(PENDING)
  submittedBy String
  submitter   User                             @relation("PaymentEligibilitySubmitter", fields: [submittedBy], references: [id])
  reviewedBy  String?
  reviewer    User?                            @relation("PaymentEligibilityReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  comments    String?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  rows        PaymentEligibilityImportRow[]

  @@index([merchantId])
  @@index([status])
}

model PaymentEligibilityImportRow {
  id       String                   @id @default(cuid())
  importId String
  import   PaymentEligibilityImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  phone    String

  @@index([importId])
}

model PaymentEligibleCustomer {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  phone      String
  approvedAt DateTime @default(now())

  @@unique([merchantId, phone])
  @@index([merchantId])
}

model MerchantCashbackConfig {
  id                        String       @id @default(cuid())
  merchantId                String       @unique
  merchant                  Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  enabled                   Boolean      @default(false)
  mode                      CashbackMode @default(ALL_CUSTOMERS)
  subsidiaryAccountNumber   String?
  allCustomersPercent       Float?
  allCustomersMinAmount     Float?
  allCustomersMaxAmount     Float?
  categories                CashbackCategory[]
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model CashbackCategory {
  id                   String   @id @default(cuid())
  configId             String
  config               MerchantCashbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  merchantId           String
  name                 String
  description          String?
  percent              Float
  minTransactionAmount Float?   @default(0)
  maxTransactionAmount Float?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  eligibleCustomers    CashbackEligibleCustomer[]
  cashbackTransactions CashbackTransaction[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([configId, name])
  @@index([merchantId])
}

model CashbackEligibleCustomer {
  id            String           @id @default(cuid())
  merchantId    String
  merchant      Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  configId      String
  categoryId    String
  category      CashbackCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  phone         String
  accountNumber String?
  importedAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([merchantId, phone, categoryId])
  @@index([merchantId, phone])
  @@index([categoryId])
}

model CashbackTransaction {
  id                   String                   @id @default(cuid())
  merchantId           String
  merchant             Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentTransactionId String                   @unique
  transactionReference String
  configId             String
  categoryId           String?
  category             CashbackCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customerPhone        String?
  customerAccount      String?
  paymentAmount        Float
  cashbackAmount       Float
  cashbackPercent      Float
  status               CashbackProcessingStatus @default(PENDING)
  skipReason           String?
  idempotencyKey       String                   @unique
  subsidiaryAccount    String?
  providerDebitRef     String?
  providerCreditRef    String?
  failureReason        String?
  processedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  logs                 CashbackProcessingLog[]
  requests             CashbackRequest[]

  @@index([merchantId, createdAt])
  @@index([status])
}

model CashbackProcessingLog {
  id                    String              @id @default(cuid())
  cashbackTransactionId String
  cashbackTransaction   CashbackTransaction @relation(fields: [cashbackTransactionId], references: [id], onDelete: Cascade)
  level                 String
  message               String
  metadata              Json?
  createdAt             DateTime            @default(now())

  @@index([cashbackTransactionId, createdAt])
}

model MerchantQrCode {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  token      String   @unique // The unique identifier in the QR URL
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([token])
}

/// Optional catalog category grouping a merchant's priced items. Purely a
/// convenience for prefilling the Push Payment amount/description — items
/// are never mandatory and don't affect the payment flow itself.
model MerchantItemCategory {
  id         String         @id @default(cuid())
  merchantId String
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  items      MerchantItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([merchantId, name])
  @@index([merchantId])
}

model MerchantItem {
  id               String                @id @default(cuid())
  merchantId       String
  merchant         Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         MerchantItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String
  price            Float
  sortOrder        Int                   @default(0)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  transactionLines TransactionItem[]

  @@unique([merchantId, categoryId, name])
  @@index([merchantId])
  @@index([categoryId])
}

/// Snapshot of a catalog item as it was at checkout. Kept even if the source
/// MerchantItem is later renamed or deleted, so past transactions and the
/// item filter stay accurate; itemId is only used to filter/relink to the
/// still-current catalog entry.
model TransactionItem {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemId        String?
  item          MerchantItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name          String
  price         Float
  quantity      Int          @default(1)
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@index([itemId])
}

enum MerchantStatus {
  PENDING
  BRANCH_APPROVED
  APPROVED
  REJECTED
  REJECTED_WITH_UPDATE
  RESUBMITTED
  ACTIVE
}

model MerchantUpdateToken {
  id         String   @id @default(cuid())
  token      String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  otp        String?  // The OTP sent to merchant
  otpExpires DateTime?
  verified   Boolean  @default(false)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model MerchantDocument {
  id         String   @id
  name       String
  type       String
  size       Int
  url        String
  uploadedAt DateTime @default(now())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantTeamMember {
  id         String           @id @default(cuid())
  merchantId String
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  otp        String?
  otpExpires DateTime?
  role       TeamRole         @default(PAYMENT_INITIATOR)
  status     TeamMemberStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())

  @@unique([merchantId, email])
  @@unique([merchantId, phone])
}

enum TeamRole {
  PAYMENT_INITIATOR
  ACCOUNT_ADMIN
  SALES_ADMIN
}

enum TeamMemberStatus {
  ACTIVE
  DEACTIVATED
}

model Transaction {
  id                   String            @id
  merchantId           String
  merchant             Merchant          @relation(fields: [merchantId], references: [id])
  amount               Float
  status               TransactionStatus @default(INITIATED)
  callbackUrl          String
  description          String
  timestamp            DateTime          @default(now())
  payerPhone           String?
  payerAccount         String?
  transactionReference String            @unique
  serviceDescription   String
  transactionTimestamp DateTime          @default(now())
  userCredentials      Json
  paymentMethod        PaymentMethod     @default(BANK)
  /// Core-banking FT / receipt number for this payment. Promoted out of the
  /// userCredentials blob so it can be searched and so one receipt can never
  /// settle two transactions. Populated by the provider callback, the status
  /// poll, or manual FT reconciliation.
  cbsreference         String?           @unique
  reconciliationRequests PaymentReconciliationRequest[]
  items                TransactionItem[]
}

enum PaymentReconciliationRequestStatus {
  PENDING
  REJECTED
  EXECUTED
}

/// Maker/checker record for settling a payment from an FT on an internal bank
/// receipt, used when the provider callback never resolved the transaction.
/// The FT is the evidence — no provider call is made.
model PaymentReconciliationRequest {
  id            String                             @id @default(cuid())
  transactionId String
  transaction   Transaction                        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ftNumber      String
  previousStatus String
  reason        String
  comments      String?
  status        PaymentReconciliationRequestStatus @default(PENDING)
  makerId       String
  maker         User                               @relation("PaymentReconciliationRequestMaker", fields: [makerId], references: [id])
  checkerId     String?
  checker       User?                              @relation("PaymentReconciliationRequestChecker", fields: [checkerId], references: [id])
  checkedAt     DateTime?
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @updatedAt

  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentMethod {
  BANK
  TELEBIRR
}

enum TransactionStatus {
  SUCCESS
  FAILED
  INITIATED
  PENDING
  AWAITING_PIN
  PROCESSING
}

model SystemConfig {
  id                  String   @id @default("1")
  maxFileSizeMB       Int      @default(5)
  allowedFileTypes    String[]
  districts           Json     @default("[]")
  branches            Json     @default("[]")
  categories          Json     @default("[]")
  businessTypes       Json     @default("[]")
  resetTimeoutSeconds Int      @default(300)
}

model IpLockout {
  id           String    @id @default(cuid())
  ipAddress    String    @unique
  attempts     Int       @default(0)
  lockoutUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Tracks failed credential attempts per normalized login identifier (email / phone username).
/// Separate from User.id so unknown identifiers still accrue lockouts.
model LoginIdentifierLockout {
  normalizedKey  String    @id
  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?
  updatedAt      DateTime  @updatedAt
}

enum TokenType {
  PASSWORD_SETUP
  MERCHANT_UPDATE
  RESET_PASSWORD
  PAYMENT
}

model OpaqueToken {
  id          String    @id @default(cuid())
  token       String    @unique
  type        TokenType
  data        Json
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

model RequestNonce {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  nonce         String
  expiresAt     DateTime
  usedAt        DateTime?

  @@unique([merchantId, nonce])
  @@index([expiresAt])
}

enum MerchantCallbackStatus {
  PENDING
  DELIVERED
  EXHAUSTED
}

/// Queues merchant webhook deliveries that failed all immediate retries.
/// Processed manually via POST /api/admin/retry-callbacks.
model MerchantCallbackQueue {
  id            String                 @id @default(cuid())
  transactionId String
  merchantId    String
  callbackUrl   String
  payload       Json
  status        MerchantCallbackStatus @default(PENDING)
  attempts      Int                    @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, nextRetryAt])
  @@index([transactionId])
  @@index([merchantId])
}

