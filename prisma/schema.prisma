generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  password              String?
  role                  UserRole  @default(MERCHANT)
  customRoleId          String?
  customRole            Role?     @relation(fields: [customRoleId], references: [id])
  merchantId            String?
  merchant              Merchant? @relation(fields: [merchantId], references: [id])
  isHeadOffice          Boolean   @default(false)
  district              String?
  branch                String?
  status                UserStatus @default(ACTIVE)
  firstLogin            Boolean    @default(true)
  failedLoginAttempts   Int        @default(0)
  lockoutUntil          DateTime?
  passwordResetToken    String?    @unique
  passwordResetExpires  DateTime?
  auditLogs             AuditLog[]
  createdRoles          Role[]    @relation("RoleCreator")
  createdMerchants      Merchant[] @relation("MerchantCreator")
  limitsSetMerchants    Merchant[] @relation("MerchantLimitsSetter")
  approvedMerchants     Merchant[] @relation("MerchantApprover")
  refreshTokens         RefreshToken[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model RefreshToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId     String   // groups rotated tokens; revoke whole family on reuse
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  replacedById String?  @unique
  replacedBy   RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("RefreshTokenReplacement")

  userAgent    String?
  ipAddress    String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  MAKER
  CHECKER
  HEAD_OFFICE
  MERCHANT
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdBy   String?
  creator     User?            @relation("RoleCreator", fields: [createdBy], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  category    String           // e.g., "DASHBOARD", "MERCHANT", "USER_ROLE", "TRANSACTION"
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g., "ROLE_CREATE", "MERCHANT_APPROVE"
  entityType  String   // e.g., "ROLE", "MERCHANT", "USER"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model Merchant {
  id                  String           @id
  name                String
  email               String           @unique
  password            String?
  logoUrl             String?
  jweSecret           String
  accountNumber       String
  dailyLimit          Float            @default(0)
  transactionLimit    Float            @default(0)
  dailyCountLimit     Int              @default(0)
  status              MerchantStatus   @default(PENDING)
  rejectionReason     String?
  businessDescription String?
  websiteUrl          String?
  callbackUrl         String?
  contactName         String
  contactUsername     String
  branchName          String
  district            String
  category            String
  businessType        String
  riskFactors         String[]
  createdBy           String?
  creator             User?            @relation("MerchantCreator", fields: [createdBy], references: [id])
  limitsSetBy         String?
  limitsSetter        User?            @relation("MerchantLimitsSetter", fields: [limitsSetBy], references: [id])
  approvedBy          String?
  approver            User?            @relation("MerchantApprover", fields: [approvedBy], references: [id])
  createdAt           DateTime         @default(now())
  passwordResetToken  String?          @unique
  passwordResetExpires DateTime?
  updateComments      Json?            // Field-level comments for corrections
  updateTokens        MerchantUpdateToken[]
  documents           MerchantDocument[]
  transactions        Transaction[]
  teamMembers         MerchantTeamMember[]
  users               User[]
  nonces              RequestNonce[]
}

enum MerchantStatus {
  PENDING
  BRANCH_APPROVED
  APPROVED
  REJECTED
  REJECTED_WITH_UPDATE
  RESUBMITTED
  ACTIVE
}

model MerchantUpdateToken {
  id         String   @id @default(cuid())
  token      String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  otp        String?  // The OTP sent to merchant
  otpExpires DateTime?
  verified   Boolean  @default(false)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model MerchantDocument {
  id         String   @id
  name       String
  type       String
  size       Int
  url        String
  uploadedAt DateTime @default(now())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantTeamMember {
  id         String           @id @default(cuid())
  merchantId String
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  role       TeamRole         @default(PAYMENT_INITIATOR)
  status     TeamMemberStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
}

enum TeamRole {
  PAYMENT_INITIATOR
  ACCOUNT_ADMIN
}

enum TeamMemberStatus {
  ACTIVE
  DEACTIVATED
}

model Transaction {
  id                   String            @id
  merchantId           String
  merchant             Merchant          @relation(fields: [merchantId], references: [id])
  amount               Float
  status               TransactionStatus @default(INITIATED)
  callbackUrl          String
  description          String
  timestamp            DateTime          @default(now())
  payerPhone           String?
  transactionReference String            @unique
  serviceDescription   String
  transactionTimestamp DateTime          @default(now())
  userCredentials      Json
  paymentMethod        PaymentMethod     @default(BANK)
}

enum PaymentMethod {
  BANK
  TELEBIRR
}

enum TransactionStatus {
  SUCCESS
  FAILED
  INITIATED
  PENDING
  AWAITING_PIN
  PROCESSING
}

model SystemConfig {
  id                  String   @id @default("1")
  maxFileSizeMB       Int      @default(5)
  allowedFileTypes    String[]
  districts           Json     @default("[]")
  branches            Json     @default("[]")
  categories          Json     @default("[]")
  businessTypes       Json     @default("[]")
  resetTimeoutSeconds Int      @default(300)
}

model IpLockout {
  id           String    @id @default(cuid())
  ipAddress    String    @unique
  attempts     Int       @default(0)
  lockoutUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Tracks failed credential attempts per normalized login identifier (email / phone username).
/// Separate from User.id so unknown identifiers still accrue lockouts.
model LoginIdentifierLockout {
  normalizedKey  String    @id
  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?
  updatedAt      DateTime  @updatedAt
}

enum TokenType {
  PASSWORD_SETUP
  MERCHANT_UPDATE
  RESET_PASSWORD
  PAYMENT
}

model OpaqueToken {
  id          String    @id @default(cuid())
  token       String    @unique
  type        TokenType
  data        Json
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

model RequestNonce {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  nonce         String
  expiresAt     DateTime
  usedAt        DateTime?
  
  @@unique([merchantId, nonce])
  @@index([expiresAt])
}

